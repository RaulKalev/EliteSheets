<Window
    x:Class="EliteSheets.ThemedMessageDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:EliteSheets.Helpers"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Width="420"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/EliteSheets;component/UI/Themes/ElementStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        Background="{DynamicResource PrimaryBackgroundBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="2"
        CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Title bar  -->
            <Border
                Grid.Row="0"
                Background="Transparent"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock
                    x:Name="TitleText"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="{DynamicResource ForegroundBrush}" />
            </Border>

            <!--  Message  -->
            <materialDesign:Card
                Grid.Row="1"
                Margin="10,0,10,10"
                Padding="12"
                Background="{DynamicResource SecondaryBackgroundBrush}"
                UniformCornerRadius="10">
                <DockPanel>
                    <materialDesign:PackIcon
                        x:Name="DialogIcon"
                        Width="28"
                        Height="28"
                        Margin="0,0,12,0"
                        VerticalAlignment="Top"
                        DockPanel.Dock="Left"
                        Foreground="#E0A030"
                        Kind="AlertCircleOutline" />
                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            x:Name="MessageText"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{DynamicResource ForegroundBrush}"
                            TextWrapping="Wrap" />
                    </ScrollViewer>
                </DockPanel>
            </materialDesign:Card>

            <StackPanel
                Grid.Row="2"
                Margin="0,0,10,10"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    x:Name="YesButton"
                    Width="100"
                    Height="30"
                    Margin="0,0,10,0"
                    AutomationProperties.Name="{helpers:Tr Yes}"
                    Click="YesButton_Click"
                    Content="{helpers:Tr Yes}"
                    FontSize="14"
                    Style="{StaticResource CustomActionButtonStyle}"
                    Visibility="Collapsed" />
                <Button
                    x:Name="OkButton"
                    Margin="0"
                    Width="100"
                    Height="30"
                    AutomationProperties.Name="{helpers:Tr CloseDialog}"
                    Click="OkButton_Click"
                    Content="{helpers:Tr Ok}"
                    FontSize="14"
                    IsCancel="True"
                    IsDefault="True"
                    Style="{StaticResource CustomActionButtonStyle}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
