<Window
    x:Class="EliteSheets.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:EliteSheets"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Name="Root"
    Title="Jooniste printimine"
    Width="1040"
    Height="720"
    MinWidth="880"
    MinHeight="560"
    Background="{DynamicResource Window.Background}"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True">
    <!--
        Standard Windows frame behaviour (Aero Snap, Win+arrows, native resize borders, DWM shadow and Windows 11
        rounded corners) with the caption area drawn by EliteSheets – the same shell as Sentinel.
        Layout: title · toolbar (search) · sheet list · floating action bar (formats, destination, Print).
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="52"
            CornerRadius="0"
            GlassFrameThickness="0,0,0,1"
            NonClientFrameEdges="None"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!--
        No <ResourceDictionary> element here on purpose: the palette and shared styles are merged into the window's
        existing Resources by the constructor before InitializeComponent (see ThemeResources), and these entries are
        added next to them. Declaring a new dictionary would replace the merged ones.
    -->
    <Window.Resources>
        <Style x:Key="CellText" TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style
            x:Key="CellText.Number"
            BasedOn="{StaticResource CellText}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style
            x:Key="CellText.Secondary"
            BasedOn="{StaticResource CellText}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        </Style>

        <!--  Destination path: read-only value in an inset well; placeholder (Tag) when no folder is chosen  -->
        <Style
            x:Key="PathValue"
            BasedOn="{StaticResource Input.ReadOnlyValue}"
            TargetType="{x:Type TextBox}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Tag" Value="No folder chosen" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="ToolTip" Value="{x:Null}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PathWell" TargetType="{x:Type Border}">
            <Setter Property="Height" Value="{StaticResource Size.Control}" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="{DynamicResource Surface.Inset}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Surface.Stroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        </Style>
        <Style x:Key="PathGlyph" TargetType="{x:Type materialDesign:PackIcon}">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
        </Style>
        <!--  Small caption above each group in the action bar  -->
        <Style
            x:Key="BarLabel"
            BasedOn="{StaticResource Type.Caption}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
    </Window.Resources>

    <Grid
        x:Name="RootGrid"
        Background="{DynamicResource Window.Background}"
        TextElement.FontFamily="{StaticResource Font.Text}"
        TextElement.FontSize="{StaticResource FontSize.Body}"
        TextElement.Foreground="{DynamicResource Text.Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ============ Title area (draggable caption) ============  -->
        <DockPanel Background="Transparent">
            <StackPanel
                VerticalAlignment="Top"
                DockPanel.Dock="Right"
                Orientation="Horizontal">
                <Button
                    x:Name="ThemeButton"
                    Width="32"
                    Height="32"
                    Margin="0,10,8,0"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="Switch between dark and light appearance"
                    Click="ToggleTheme_Click"
                    Style="{StaticResource Button.Icon}"
                    ToolTip="Switch between dark and light appearance"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <materialDesign:PackIcon
                        x:Name="ThemeIcon"
                        Width="17"
                        Height="17"
                        Kind="WeatherNight" />
                </Button>
                <Button
                    AutomationProperties.Name="Minimize"
                    Click="Minimize_Click"
                    Style="{StaticResource CaptionButton}"
                    ToolTip="Minimize">
                    <materialDesign:PackIcon
                        Width="14"
                        Height="14"
                        Kind="WindowMinimize" />
                </Button>
                <Button
                    x:Name="MaximizeButton"
                    AutomationProperties.Name="Maximize"
                    Click="Maximize_Click"
                    Style="{StaticResource CaptionButton}"
                    ToolTip="Maximize">
                    <materialDesign:PackIcon
                        x:Name="MaximizeIcon"
                        Width="14"
                        Height="14"
                        Kind="WindowMaximize" />
                </Button>
                <Button
                    AutomationProperties.Name="Close"
                    Click="Close_Click"
                    Style="{StaticResource CaptionCloseButton}"
                    ToolTip="Close">
                    <materialDesign:PackIcon
                        Width="14"
                        Height="14"
                        Kind="WindowClose" />
                </Button>
            </StackPanel>

            <!--  App name + where the sheets come from  -->
            <StackPanel
                Margin="18,0,12,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource Type.Section}"
                    Text="Jooniste printimine" />
                <TextBlock
                    x:Name="ProjectText"
                    MaxWidth="360"
                    Margin="10,2,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource Type.Secondary}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </StackPanel>
        </DockPanel>

        <!--  ============ Toolbar: search · reload · selection summary ============  -->
        <DockPanel Grid.Row="1" Margin="16,0,16,12">
            <TextBlock
                x:Name="SelectionText"
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                AutomationProperties.LiveSetting="Polite"
                Style="{StaticResource Type.Secondary}"
                TextWrapping="NoWrap" />
            <StackPanel Orientation="Horizontal">
                <Grid Width="300">
                    <TextBox
                        x:Name="SheetSearchTextBox"
                        AutomationProperties.Name="Search sheets"
                        Style="{StaticResource Input.Search}"
                        Tag="Search number, name or version"
                        TextChanged="SheetSearchTextBox_TextChanged"
                        ToolTip="Search sheets by number, name, version or view (Ctrl+F)" />
                    <Button
                        x:Name="ClearSearchButton"
                        Width="24"
                        Height="24"
                        Margin="0,0,4,0"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Clear search"
                        Click="ClearSearchButton_Click"
                        Style="{StaticResource Button.Icon}"
                        ToolTip="Clear search (Esc)"
                        Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVis}}">
                        <materialDesign:PackIcon
                            Width="14"
                            Height="14"
                            Kind="CloseCircle" />
                    </Button>
                </Grid>
                <Button
                    x:Name="ReloadButton"
                    Width="32"
                    Height="32"
                    Margin="8,0,0,0"
                    AutomationProperties.Name="Reload sheets"
                    Click="ReloadButton_Click"
                    Style="{StaticResource Button.Icon}"
                    ToolTip="Reload sheets and DWG setups from the model">
                    <materialDesign:PackIcon
                        Width="17"
                        Height="17"
                        Kind="Refresh" />
                </Button>
            </StackPanel>
        </DockPanel>

        <!--  ============ Sheet list ============  -->
        <Border
            Grid.Row="2"
            Margin="16,0,16,0"
            Padding="0,4,0,4"
            Style="{StaticResource Surface}">
            <Grid>
                <DataGrid
                    x:Name="SheetsDataGrid"
                    AutomationProperties.Name="Sheets"
                    ItemsSource="{Binding Sheets}"
                    PreviewKeyDown="SheetsDataGrid_PreviewKeyDown"
                    PreviewMouseLeftButtonDown="SheetsDataGrid_PreviewMouseLeftButtonDown"
                    SelectionMode="Extended"
                    Style="{StaticResource SheetGrid}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="44" CanUserResize="False">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        x:Name="CheckAllBox"
                                        HorizontalAlignment="Center"
                                        AutomationProperties.Name="Select all visible sheets"
                                        Click="CheckAllBox_Click"
                                        Loaded="CheckAllBox_Loaded"
                                        Style="{StaticResource Input.Check}"
                                        ToolTip="Select or clear all visible sheets" />
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        HorizontalAlignment="Center"
                                        Click="Checkbox_Click"
                                        IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource Input.Check}">
                                        <AutomationProperties.Name>
                                            <MultiBinding StringFormat="Select sheet {0} - {1}">
                                                <Binding Path="Number" />
                                                <Binding Path="Name" />
                                            </MultiBinding>
                                        </AutomationProperties.Name>
                                    </CheckBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Width="180"
                            MinWidth="100"
                            Binding="{Binding Number}"
                            ElementStyle="{StaticResource CellText.Number}"
                            Header="Joonise number" />
                        <DataGridTextColumn
                            Width="*"
                            MinWidth="160"
                            Binding="{Binding Name}"
                            ElementStyle="{StaticResource CellText}"
                            Header="Joonise nimi" />
                        <DataGridTextColumn
                            Width="96"
                            MinWidth="72"
                            Binding="{Binding Version}"
                            ElementStyle="{StaticResource CellText.Secondary}"
                            Header="Versioon" />
                    </DataGrid.Columns>
                </DataGrid>

                <!--  Empty state: says what happened and how to get out of it  -->
                <StackPanel
                    x:Name="EmptyState"
                    Margin="24,40,24,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    local:Motion.Reveal="True"
                    Visibility="Collapsed">
                    <materialDesign:PackIcon
                        Width="32"
                        Height="32"
                        Margin="0,0,0,10"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource Text.Tertiary}"
                        Kind="FileSearchOutline" />
                    <TextBlock
                        x:Name="EmptyTitle"
                        HorizontalAlignment="Center"
                        Style="{StaticResource Type.Heading}"
                        Text="No matching sheets" />
                    <TextBlock
                        x:Name="EmptyDetail"
                        MaxWidth="320"
                        Margin="0,4,0,12"
                        HorizontalAlignment="Center"
                        Style="{StaticResource Type.Secondary}"
                        TextAlignment="Center" />
                    <Button
                        x:Name="EmptyClearButton"
                        HorizontalAlignment="Center"
                        Click="ClearSearchButton_Click"
                        Content="Clear search"
                        Style="{StaticResource Button.Plain}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  ============ Action bar (single floating layer) ============  -->
        <Border
            Grid.Row="3"
            Margin="16,12,16,16"
            Padding="16,12,16,14"
            Style="{StaticResource Floating}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Formats  -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Style="{StaticResource BarLabel}" Text="Format" />
                    <StackPanel Orientation="Horizontal">
                        <CheckBox
                            x:Name="PdfExportCheckbox"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="Export to PDF"
                            Click="FormatCheckbox_Click"
                            Content="PDF"
                            IsChecked="True"
                            Style="{StaticResource Toggle.Chip}"
                            ToolTip="Export selected sheets as PDF" />
                        <CheckBox
                            x:Name="DwgExportCheckbox"
                            AutomationProperties.Name="Export to DWG"
                            Click="FormatCheckbox_Click"
                            Content="DWG"
                            IsChecked="True"
                            Style="{StaticResource Toggle.Chip}"
                            ToolTip="Export selected sheets as DWG" />
                    </StackPanel>
                </StackPanel>

                <!--  DWG setup (only meaningful when DWG is on – placed next to the control it depends on)  -->
                <StackPanel
                    Grid.Column="1"
                    Margin="0,0,20,0"
                    IsEnabled="{Binding IsChecked, ElementName=DwgExportCheckbox}">
                    <TextBlock
                        x:Name="DwgExportSettingsLabel"
                        Style="{StaticResource BarLabel}"
                        Text="DWG setup" />
                    <ComboBox
                        x:Name="DwgExportComboBox"
                        Width="190"
                        AutomationProperties.LabeledBy="{Binding ElementName=DwgExportSettingsLabel}"
                        DisplayMemberPath="Name"
                        Style="{StaticResource Input.Combo}"
                        ToolTip="DWG export setup defined in the Revit project" />
                </StackPanel>

                <!--  Destination  -->
                <StackPanel Grid.Column="2" Margin="0,0,20,0">
                    <DockPanel>
                        <CheckBox
                            x:Name="SeparateFoldersCheckbox"
                            Margin="12,0,0,6"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="Use separate folders for PDF and DWG"
                            Click="SeparateFoldersCheckbox_Click"
                            Content="Separate folders"
                            DockPanel.Dock="Right"
                            FontSize="{StaticResource FontSize.Secondary}"
                            Foreground="{DynamicResource Text.Secondary}"
                            Style="{StaticResource Input.Check}"
                            ToolTip="Export PDF and DWG files to different folders" />
                        <TextBlock Style="{StaticResource BarLabel}" Text="Destination" />
                    </DockPanel>

                    <!--  One folder  -->
                    <DockPanel x:Name="SingleFolderPanel" local:Motion.Reveal="True">
                        <Button
                            x:Name="BrowseButton"
                            Margin="8,0,0,0"
                            AutomationProperties.Name="Choose export folder"
                            Click="BrowseButton_Click"
                            Content="Choose…"
                            DockPanel.Dock="Right"
                            Style="{StaticResource Button.Secondary}"
                            ToolTip="Choose the folder for exported files" />
                        <Border Style="{StaticResource PathWell}">
                            <DockPanel>
                                <materialDesign:PackIcon Kind="FolderOutline" Style="{StaticResource PathGlyph}" />
                                <TextBox
                                    x:Name="ExportPathTextBox"
                                    AutomationProperties.Name="Export folder"
                                    Style="{StaticResource PathValue}" />
                            </DockPanel>
                        </Border>
                    </DockPanel>

                    <!--  Separate folders  -->
                    <StackPanel
                        x:Name="SeparateFoldersPanel"
                        local:Motion.Reveal="True"
                        Visibility="Collapsed">
                        <DockPanel Margin="0,0,0,6">
                            <Button
                                x:Name="BrowsePdfButton"
                                Margin="8,0,0,0"
                                AutomationProperties.Name="Choose PDF export folder"
                                Click="BrowsePdfButton_Click"
                                Content="Choose…"
                                DockPanel.Dock="Right"
                                Style="{StaticResource Button.Secondary}"
                                ToolTip="Choose the folder for exported PDF files" />
                            <Border Style="{StaticResource PathWell}">
                                <DockPanel>
                                    <Border
                                        Margin="0,0,8,0"
                                        Style="{StaticResource Badge.Accent}">
                                        <TextBlock Text="PDF" />
                                    </Border>
                                    <TextBox
                                        x:Name="PdfExportPathTextBox"
                                        AutomationProperties.Name="PDF export folder"
                                        Style="{StaticResource PathValue}" />
                                </DockPanel>
                            </Border>
                        </DockPanel>
                        <DockPanel>
                            <Button
                                x:Name="BrowseDwgButton"
                                Margin="8,0,0,0"
                                AutomationProperties.Name="Choose DWG export folder"
                                Click="BrowseDwgButton_Click"
                                Content="Choose…"
                                DockPanel.Dock="Right"
                                Style="{StaticResource Button.Secondary}"
                                ToolTip="Choose the folder for exported DWG files" />
                            <Border Style="{StaticResource PathWell}">
                                <DockPanel>
                                    <Border
                                        Margin="0,0,8,0"
                                        Style="{StaticResource Badge.Accent}">
                                        <TextBlock Text="DWG" />
                                    </Border>
                                    <TextBox
                                        x:Name="DwgExportPathTextBox"
                                        AutomationProperties.Name="DWG export folder"
                                        Style="{StaticResource PathValue}" />
                                </DockPanel>
                            </Border>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>

                <!--  The one primary action  -->
                <Button
                    x:Name="PrintButton"
                    Grid.Column="3"
                    Height="36"
                    MinWidth="150"
                    Padding="18,0"
                    VerticalAlignment="Bottom"
                    AutomationProperties.Name="Print and export selected sheets"
                    Click="PrintButton_Click"
                    IsDefault="False"
                    Style="{StaticResource Button.Primary}"
                    ToolTip="Print and export the selected sheets (Ctrl+Enter)">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PrinterOutline" Style="{StaticResource ButtonIconLabel}" />
                        <TextBlock x:Name="PrintButtonText" Text="Print" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
