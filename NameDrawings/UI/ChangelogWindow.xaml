<Window
    x:Class="EliteSheets.ChangelogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:EliteSheets.Helpers"
    Title="{helpers:Tr WhatsNewTitle}"
    Width="512"
    MaxHeight="640"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">
    <!--
        "What's new" sheet in the plugin's design language: one floating surface (margin = room for the shadow),
        newest version as the headline, older unseen versions below in the scroll area, one primary action.
        The owner's palette and the shared styles are merged in by the constructor (see ThemeResources).
    -->
    <Border
        Margin="16"
        Padding="22,20,22,16"
        MouseLeftButtonDown="Surface_MouseLeftButtonDown"
        Style="{StaticResource Floating}"
        TextElement.FontFamily="{StaticResource Font.Text}"
        TextElement.FontSize="{StaticResource FontSize.Body}"
        TextElement.Foreground="{DynamicResource Text.Primary}">
        <DockPanel>
            <!--  Headline  -->
            <StackPanel Margin="0,0,0,14" DockPanel.Dock="Top">
                <TextBlock Style="{StaticResource Type.Caption}" Text="{helpers:Tr AppTitle}" />
                <TextBlock
                    Margin="0,2,0,0"
                    Style="{StaticResource Type.Title}"
                    Text="{helpers:Tr WhatsNewTitle}" />
                <TextBlock
                    x:Name="VersionText"
                    Margin="0,4,0,0"
                    Style="{StaticResource Type.Secondary}" />
            </StackPanel>

            <!--  The one action  -->
            <Button
                Margin="0,16,0,0"
                MinWidth="96"
                HorizontalAlignment="Right"
                AutomationProperties.Name="{helpers:Tr CloseDialog}"
                Click="Close_Click"
                Content="{helpers:Tr GotIt}"
                DockPanel.Dock="Bottom"
                IsCancel="True"
                IsDefault="True"
                Style="{StaticResource Button.Primary}" />

            <ScrollViewer
                MaxHeight="420"
                Padding="0,0,6,0"
                VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="VersionsPanel" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
